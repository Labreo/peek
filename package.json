{
  "name": "peek",
  "version": "0.2.0",
  "private": true,
  "description": "Peek: a horror game where your MacBook lid is your eyelids. Built on the Presage SmartSpectra SDK.",
  "keywords": [
    "presage",
    "smartspectra",
    "electron",
    "horror",
    "game",
    "biofeedback",
    "macbook",
    "lid-angle"
  ],
  "homepage": "https://github.com/Labreo/peek#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Labreo/peek.git"
  },
  "bugs": {
    "url": "https://github.com/Labreo/peek/issues"
  },
  "license": "MIT",
  "author": "Labreo",
  "main": "dist/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --debug",
    "replay": "npm run build && electron . --replay",
    "sim": "npm run build && electron . --sim-lid",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "spike:presage": "node scripts/spike-presage.cjs",
    "make:sample": "esbuild scripts/make-sample-run.ts --bundle --platform=node --format=cjs --outfile=dist/make-sample-run.cjs --log-level=warning && node dist/make-sample-run.cjs",
    "demo": "npm run build && electron . --presenter",
    "prepublish-check": "bash scripts/prepublish-check.sh"
  },
  "dependencies": {
    "@smartspectra/node-sdk": "3.5.0",
    "node-hid": "^3.4.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.170.0",
    "electron": "^43.8.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "koffi@2.16.4": true,
    "protobufjs@7.6.6": true,
    "electron@43.8.1": true
  }
}
